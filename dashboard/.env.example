# Copier en .env.local (ignoré par git) et remplir. Ne jamais commiter .env.local.
# Source de données : mock (fixtures en mémoire) ou db (piste B, exige DATABASE_URL).
DATA_SOURCE=mock
# Base locale : PostgreSQL installé sur le poste (scripts/setup-local.sql crée le rôle fig et la base fig,
# port 5432) ou Docker (compose.yaml, port 5433). Requise en mode db et par npm run db:* .
# DATABASE_URL=postgresql://fig:fig@localhost:5432/fig
# A7 : secret de signature des sessions, 32 caractères minimum. Générer : npx auth secret
AUTH_SECRET=
# A7 : compte d'amorçage (rôle admin) tant que les comptes ne viennent pas d'une base.
AUTH_BOOTSTRAP_EMAIL=admin@example.invalid
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_NAME=Administrateur
# Production seulement (audit du 2026-09-14) : URL publique du dashboard, obligatoire
# (l'hôte n'est plus deviné), et deux dérogations explicites réservées à une démo assumée.
# AUTH_URL=https://dashboard.example.invalid
# AUTH_ALLOW_BOOTSTRAP=1
# ALLOW_MOCK_IN_PRODUCTION=1
# Second compte, rôle gestionnaire (optionnel, les deux premières vont ensemble).
# AUTH_MANAGER_EMAIL=gestion@example.invalid
# AUTH_MANAGER_PASSWORD=
# AUTH_MANAGER_NAME=Gestionnaire
