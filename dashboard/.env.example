# Copier en .env.local (ignoré par git) et remplir. Ne jamais commiter .env.local.
# Base PostgreSQL de développement, OBLIGATOIRE (il n'y a plus de mode sans base) :
# PostgreSQL installé sur le poste (scripts/setup-local.sql, port 5432) ou Docker
# (`docker compose up -d db`, port 5433). Puis `npm run db:migrate && npm run db:seed`.
DATABASE_URL=postgresql://fig:fig@localhost:5432/fig
# Secret de signature des sessions, 32 caractères minimum. Générer : npx auth secret
AUTH_SECRET=
# Comptes créés par `npm run db:seed` (rôle admin, puis gestionnaire optionnel) ;
# l'application ne lit plus ces variables : les comptes vivent dans la table users.
AUTH_BOOTSTRAP_EMAIL=admin@example.invalid
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_NAME=Administrateur
# AUTH_MANAGER_EMAIL=gestion@example.invalid
# AUTH_MANAGER_PASSWORD=
# AUTH_MANAGER_NAME=Gestionnaire
# Production seulement : URL publique du dashboard, obligatoire (l'hôte n'est plus deviné).
# AUTH_URL=https://dashboard.example.invalid
# Tests (npm run check, npm run test:e2e) : base jetable `docker compose up -d --wait test-db`.
# Valeur par défaut : postgresql://fig:fig@127.0.0.1:5434/fig_test
# TEST_DATABASE_URL=
